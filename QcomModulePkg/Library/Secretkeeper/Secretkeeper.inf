[Defines]
	INF_VERSION                    = 0x00010005
	BASE_NAME                      = SecretkeeperLib
	FILE_GUID                      = 38494722-c3f2-41e0-a28c-8ea590b05f9b
	MODULE_TYPE                    = BASE
	VERSION_STRING                 = 1.0
	LIBRARY_CLASS                  = SecretkeeperLib

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = $(LLVM_ENABLE_SAFESTACK) $(LLVM_SAFESTACK_USE_PTR) $(LLVM_SAFESTACK_COLORING)

[BuildOptions.AARCH64]
  GCC:*_*_*_CC_FLAGS = $(SDLLVM_COMPILE_ANALYZE) $(SDLLVM_ANALYZE_REPORT)

[Sources]
   Secretkeeper.c

[Packages]
	MdePkg/MdePkg.dec
	QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
	DxeServicesTableLib
	UefiLib
	BaseLib
	DebugLib
	DebugPrintErrorLevelLib

[Protocols]
	gQcomQseecomProtocolGuid
	gEfiPartitionRecordGuid
	gQcomScmProtocolGuid
