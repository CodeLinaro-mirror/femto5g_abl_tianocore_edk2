[Defines]
  INF_VERSION                    = 0x00010005
  BASE_NAME                      = GblLib
  FILE_GUID                      = e742c76a-4b0c-4e7e-bd97-bc5299b881d5
  MODULE_TYPE                    = BASE
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = GblLib

#
# The following information is for reference only and not required by the build tools.
#
#  VALID_ARCHITECTURES           = ARM, AARCH64
#

[BuildOptions.AARCH64]
  GCC:*_*_*_CC_FLAGS = $(SDLLVM_COMPILE_ANALYZE) $(SDLLVM_ANALYZE_REPORT)

[Sources]
  DtFixupProtocol.c
  GblAvbProtocol.c
  GblOsConfigurationProtocol.c

[BuildOptions]
  GCC:*_*_*_CC_FLAGS = $(UBSAN_UEFI_GCC_FLAG_UNDEFINED)
  GCC:*_*_*_CC_FLAGS = $(UBSAN_UEFI_GCC_FLAG_ALIGNMENT)
  GCC:*_*_*_CC_FLAGS = $(LLVM_ENABLE_SAFESTACK) $(LLVM_SAFESTACK_USE_PTR) $(LLVM_SAFESTACK_COLORING)

[Packages]
  ArmPkg/ArmPkg.dec
  EmbeddedPkg/EmbeddedPkg.dec
  MdePkg/MdePkg.dec
  MdeModulePkg/MdeModulePkg.dec
  QcomModulePkg/QcomModulePkg.dec

[LibraryClasses]
	LibUfdt
  AvbLib
  BootLib
  DebugLib
  PcdLib
  StackCanary
  UbsanLib
  UefiApplicationEntryPoint
  UefiLib

[Protocols]
  gEfiDtFixupProtocolGuid
  gEfiGblOsConfigurationProtocolGuid
  gEfiGblAvbProtocolGuid

[Guids]
  gQcomTokenSpaceGuid
